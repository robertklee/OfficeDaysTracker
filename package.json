{
  "name": "rto-planner-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "wrangler pages deploy dist",
    "cf:dev": "npm run build && wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "db:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "test:accounts": "playwright test --config playwright.accounts.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests *.ts *.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "dexie": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.37.1"
  }
}
